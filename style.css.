* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #1e293b;
  min-height: 100vh;
  padding: 35px 16px;
}

.container {
  max-width: 750px;
  margin: 0 auto;
  background: white;
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 30px;
}

.subtitle {
  color: #64748b;
  font-size: 11px;
  font-weight: bold;
  letter-spacing: 2px;
  margin-bottom: 8px;
}

h1 {
  color: #2563eb;
  font-size: 34px;
}

.description {
  color: #64748b;
  margin-top: 7px;
  font-size: 14px;
}

.counter {
  background: #eff6ff;
  color: #2563eb;
  width: 75px;
  height: 75px;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.counter span {
  font-size: 25px;
  font-weight: bold;
}

.counter small {
  font-size: 11px;
}

.form-section {
  margin-bottom: 30px;
}

form {
  display: flex;
  gap: 10px;
}

input {
  flex: 1;
  min-width: 0;
  padding: 14px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 14px;
  outline: none;
}

input:focus {
  border-color: #2563eb;
}

button {
  border: none;
  border-radius: 8px;
  background: #2563eb;
  color: white;
  padding: 0 18px;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: #1d4ed8;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

h2 {
  font-size: 18px;
}

select {
  padding: 9px;
  border: 1px solid #cbd5e1;
  border-radius: 7px;
  background: white;
}

#taskList {
  list-style: none;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px 10px;
  border-bottom: 1px solid #e2e8f0;
}

.task-item input {
  width: 18px;
  height: 18px;
  flex: none;
  accent-color: #2563eb;
}

.task-text {
  flex: 1;
  overflow-wrap: anywhere;
  font-size: 14px;
}

.task-item.completed .task-text {
  text-decoration: line-through;
  color: #94a3b8;
}

.delete-button {
  background: #fee2e2;
  color: #b91c1c;
  padding: 9px 12px;
}

.delete-button:hover {
  background: #fecaca;
}

.empty-message {
  text-align: center;
  color: #94a3b8;
  padding: 25px 5px;
  font-size: 14px;
}

footer {
  text-align: center;
  color: #94a3b8;
  font-size: 12px;
  margin-top: 30px;
}

@media (max-width: 480px) {
  .container {
    padding: 20px;
  }

  .header {
    align-items: flex-start;
  }

  form {
    flex-direction: column;
  }

  form button {
    padding: 13px;
  }
}
